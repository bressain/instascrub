{
  "manifest_version": 3,
  "name": "instascrub",
  "version": "1.0.0",
  "description": "Video controls overlay for Instagram",
  "browser_specific_settings": {
    "gecko": {
      "id": "instascrub@local",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
